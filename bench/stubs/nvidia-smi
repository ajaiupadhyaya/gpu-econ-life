#!/usr/bin/env python3
"""DRY-RUN STUB for nvidia-smi. Emits output in nvidia-smi's formats; every value is fake.

Supports the three invocations the harness uses: `-q`, a one-shot `--query-gpu ... noheader`,
and a looping `--query-gpu ... --format=csv,nounits -lms N`.
"""

import math
import sys
import time
from datetime import datetime

args = sys.argv[1:]
if "-q" in args:
    print("==============NVSMI LOG==============\n")
    print("Driver Version                            : STUB")
    print("CUDA Version                              : 0.0-stub")
    print("Attached GPUs                             : 1")
    print("    Product Name                          : STUB GPU (dry run)")
    sys.exit(0)

query = next((a.split("=", 1)[1] for a in args if a.startswith("--query-gpu=")), None)
if query is None:
    print("STUB nvidia-smi: unsupported arguments", args, file=sys.stderr)
    sys.exit(1)
fields = query.split(",")

fake = {
    "name": "STUB GPU (dry run)", "uuid": "GPU-00000000-stub", "driver_version": "STUB",
    "memory.total": "24564 MiB", "power.limit": "450.00 W", "power.max_limit": "450.00 W",
    "clocks.max.sm": "2520 MHz", "pcie.link.gen.max": "4", "pcie.link.width.max": "16",
    "compute_cap": "0.0", "index": "0",
}

if "-lms" not in args:
    print(", ".join(fake.get(f, "[N/A]") for f in fields))
    sys.exit(0)

interval = int(args[args.index("-lms") + 1]) / 1000.0
units = {"power.draw": "[W]", "utilization.gpu": "[%]", "clocks.sm": "[MHz]",
         "memory.used": "[MiB]"}
print(", ".join(f"{f} {units[f]}" if f in units else f for f in fields), flush=True)
t0 = time.time()
try:
    while True:
        t = time.time() - t0
        vals = {
            "timestamp": datetime.now().strftime("%Y/%m/%d %H:%M:%S.%f")[:-3],
            "index": "0",
            "power.draw": f"{250 + 100 * math.sin(t):.2f}",
            "utilization.gpu": "50", "temperature.gpu": "55", "clocks.sm": "2000",
            "memory.used": "20000",
        }
        print(", ".join(vals.get(f, "[N/A]") for f in fields), flush=True)
        time.sleep(interval)
except (KeyboardInterrupt, BrokenPipeError):
    sys.exit(0)
