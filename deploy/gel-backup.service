[Unit]
Description=Copy raw GPU price data to off-server storage
After=network-online.target
Wants=network-online.target
OnFailure=gel-alert@%n.service

[Service]
Type=oneshot
User=gel
WorkingDirectory=/opt/gpu-econ-life
EnvironmentFile=-/opt/gpu-econ-life/.env
ExecStart=/opt/gpu-econ-life/deploy/backup.sh
TimeoutStartSec=3600
